{
  "name": "skill-learn-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "skill-learn 项目 markdown 查看器：套件维度合并展示技能源码与中文文档",
  "scripts": {
    "dev": "vite",
    "build": "vite build && esbuild server/main.ts --bundle --platform=node --format=esm --packages=external --outdir=dist-server",
    "start": "node dist-server/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "express": "^4.19.2",
    "multer": "^2.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.21.5",
    "fflate": "^0.8.3",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.10.0",
    "jsdom": "^30.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  }
}
